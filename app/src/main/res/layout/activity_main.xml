<?xml version="1.0" encoding="utf-8"?>
<!-- Root CoordinatorLayout para soportar AppBar con menú -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8FF">


    <!-- Contenido principal debajo del AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"
        android:paddingTop="100dp"
        android:background="#F8F8FF"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Fila Usuario: etiqueta + campo -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Etiqueta Usuario -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginEnd="12dp" />

            <!-- Campo de texto Usuario -->
            <EditText
                android:id="@+id/etUsuario"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Ingrese su usuario"
                android:textColorHint="#AAAAAA"
                android:textColor="#333333"
                android:textSize="14sp"
                android:inputType="text"
                android:paddingStart="4dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_field_rounded" />

        </LinearLayout>

        <!-- Fila Password: etiqueta + campo -->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- Etiqueta Password -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginEnd="12dp" />

            <!-- Campo de texto Password -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Ingrese su password"
                android:textColorHint="#AAAAAA"
                android:textColor="#333333"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:paddingStart="4dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_field_rounded" />

        </LinearLayout>

        <!-- Fila de botones: Ingresar y Salir -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center_horizontal">

            <!-- Botón Ingresar -->
            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:text="Ingresar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"
                android:layout_marginEnd="16dp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Botón Salir -->
            <Button
                android:id="@+id/btnSalir"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:text="Salir"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>