<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="left"
        android:padding="50dp">


        <!-- Etiqueta Nombre de usuario -->
        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/hint_usuario"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="0dp" />

        <!-- Campo Nombre de usuario -->
        <EditText
            android:id="@+id/etRegUsuario"
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:hint="@string/hint_usuario"
            android:textColorHint="#AAAAAA"
            android:textColor="#333333"
            android:textSize="14sp"
            android:inputType="text"
            android:paddingStart="4dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_rounded"
            android:layout_marginBottom="20dp" />

        <!-- Etiqueta Email -->
        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/hint_email"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="0dp" />

        <!-- Campo Email -->
        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:hint="@string/hint_email"
            android:textColorHint="#AAAAAA"
            android:textColor="#333333"
            android:textSize="14sp"
            android:inputType="textEmailAddress"
            android:paddingStart="4dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_rounded"
            android:layout_marginBottom="20dp" />

        <!-- Etiqueta Password -->
        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/hint_password"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="0dp" />

        <!-- Campo Password -->
        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:hint="@string/hint_password"
            android:textColorHint="#AAAAAA"
            android:textColor="#333333"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:paddingStart="4dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_rounded"
            android:layout_marginBottom="20dp" />

        <!-- Etiqueta Confirmar Password -->
        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/hint_confirmar_password"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="0dp" />

        <!-- Campo Confirmar Password -->
        <EditText
            android:id="@+id/etRegConfirmPassword"
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:hint="@string/hint_confirmar_password"
            android:textColorHint="#AAAAAA"
            android:textColor="#333333"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:paddingStart="4dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_rounded"
            android:layout_marginBottom="28dp" />

        <!-- Fila de botones: Guardar y Regresar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center_horizontal">

            <!-- Botón Guardar -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:text="@string/btn_guardar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"
                android:layout_marginEnd="16dp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Botón Regresar -->
            <Button
                android:id="@+id/btnRegresar"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:text="@string/btn_regresar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>